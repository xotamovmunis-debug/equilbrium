6%27%20stroke%3D%27%23000%27%20stroke-width%3D%271.4%27/%3E%3C/svg%3E"}, {"id": "mi-3.3-03", "subject": "micro", "unit": 3, "topic": "3.3", "difficulty": "medium", "stem": "All of a firm's costs are variable in the long run because", "choices": ["fixed costs are always zero", "the firm must shut down", "demand becomes perfectly elastic", "the firm earns zero accounting profit", "the firm can adjust all of its inputs"], "answer": 4, "explanation": "The long run is the period long enough to change every input, including plant size, so no cost is fixed.", "image": ""}, {"id": "mi-3.3-04", "subject": "micro", "unit": 3, "topic": "3.3", "difficulty": "medium", "stem": "Minimum efficient scale is the", "choices": ["largest output a firm can produce", "output at which marginal cost is zero", "output at which total revenue is maximized", "lowest output at which long-run average total cost is minimized", "point at which economies of scale begin"], "answer": 3, "explanation": "Minimum efficient scale is the smallest output level at which the firm reaches the lowest point of its long-run average cost curve.", "image": ""}, {"id": "mi-3.3-05", "subject": "micro", "unit": 3, "topic": "3.3", "difficulty": "hard", "stem": "If a firm experiences constant returns to scale over a range of output, its long-run average total cost curve over that range is", "choices": ["upward sloping", "downward sloping", "horizontal", "vertical", "U-shaped"], "answer": 2, "explanation": "With constant returns, output grows in the same proportion as inputs, so average cost does not change as the firm expands.", "image": ""}, {"id": "mi-3.4-01", "subject": "micro", "unit": 3, "topic": "3.4", "difficulty": "easy", "stem": "For a firm in a perfectly competitive market, marginal revenue is", "choices": ["greater than price", "equal to price", "less than price", "equal to average fixed cost", "zero"], "answer": 1, "explanation": "A perfectly competitive firm is a price taker, so each additional unit sells for the market price.", "image": ""}, {"id": "mi-3.4-02", "subject": "micro", "unit": 3, "topic": "3.4", "difficulty": "medium", "stem": "A perfectly competitive firm faces a market price of $12. Its total costs are shown in the table. What quantity maximizes its profit?", "choices": ["2", "3", "4", "5", "6"], "answer": 2, "explanation": "Marginal cost is 7, 9, 11, 14, 18. The firm produces while price is at least marginal cost, so it stops at 4 units, earning $48 − $42 = $6.", "image": "data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%20235%20220%27%20width%3D%27235%27%20height%3D%27220%27%3E%3Crect%20width%3D%27235%27%20height%3D%27220%27%20fill%3D%27%23fff%27/%3E%3Cline%20x1%3D%2710%27%20y1%3D%2712%27%20x2%3D%27225%27%20y2%3D%2712%27%20stroke%3D%27%23000%27%20stroke-width%3D%271.4%27/%3E%3Ctext%20x%3D%2747.5%27%20y%3D%2731%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3EOutput%3C/text%3E%3Ctext%20x%3D%27155.0%27%20y%3D%2731%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3ETotal%20cost%20%28%24%29%3C/text%3E%3Cline%20x1%3D%2710%27%20y1%3D%2740%27%20x2%3D%27225%27%20y2%3D%2740%27%20stroke%3D%27%23000%27%20stroke-width%3D%27.9%27/%3E%3Ctext%20x%3D%2747.5%27%20y%3D%2759%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E1%3C/text%3E%3Ctext%20x%3D%27155.0%27%20y%3D%2759%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E15%3C/text%3E%3Ctext%20x%3D%2747.5%27%20y%3D%2787%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E2%3C/text%3E%3Ctext%20x%3D%27155.0%27%20y%3D%2787%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E22%3C/text%3E%3Ctext%20x%3D%2747.5%27%20y%3D%27115%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E3%3C/text%3E%3Ctext%20x%3D%27155.0%27%20y%3D%27115%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E31%3C/text%3E%3Ctext%20x%3D%2747.5%27%20y%3D%27143%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E4%3C/text%3E%3Ctext%20x%3D%27155.0%27%20y%3D%27143%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E42%3C/text%3E%3Ctext%20x%3D%2747.5%27%20y%3D%27171%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E5%3C/text%3E%3Ctext%20x%3D%27155.0%27%20y%3D%27171%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E56%3C/text%3E%3Ctext%20x%3D%2747.5%27%20y%3D%27199%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E6%3C/text%3E%3Ctext%20x%3D%27155.0%27%20y%3D%27199%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E74%3C/text%3E%3Cline%20x1%3D%2710%27%20y1%3D%27208%27%20x2%3D%27225%27%20y2%3D%27208%27%20stroke%3D%27%23000%27%20stroke-width%3D%271.4%27/%3E%3C/svg%3E"}, {"id": "mi-3.4-03", "subject": "micro", "unit": 3, "topic": "3.4", "difficulty": "medium", "stem": "In the short run, a perfectly competitive firm should shut down if the price is below its", "choices": ["average variable cost", "average total cost", "average fixed cost", "marginal revenue", "total fixed cost"], "answer": 0, "explanation": "Below average variable cost, operating loses more than the fixed cost the firm must pay anyway, so shutting down minimizes the loss.", "image": ""}, {"id": "mi-3.4-04", "subject": "micro", "unit": 3, "topic": "3.4", "difficulty": "medium", "stem": "In long-run equilibrium, a firm in a perfectly competitive industry", "choices": ["earns positive economic profit", "sets price above marginal cost", "has excess capacity", "faces a downward-sloping demand curve", "produces where price equals marginal cost and minimum average total cost"], "answer": 4, "explanation": "Entry and exit drive economic profit to zero, leaving the firm at the bottom of its ATC curve where P = MC = minimum ATC.", "image": ""}, {"id": "mi-3.4-05", "subject": "micro", "unit": 3, "topic": "3.4", "difficulty": "hard", "stem": "A perfectly competitive firm is losing money, but the price is above its average variable cost. In the short run, the firm should", "choices": ["shut down immediately", "raise its price", "reduce output to zero and exit", "continue producing where price equals marginal cost", "produce where average total cost is minimized"], "answer": 3, "explanation": "Revenue covers all variable cost and part of fixed cost, so producing loses less than shutting down.", "image": ""}, {"id": "mi-3.4-06", "subject": "micro", "unit": 3, "topic": "3.4", "difficulty": "medium", "stem": "A constant-cost, perfectly competitive industry is in long-run equilibrium when demand increases. In the long run,", "choices": ["price stays higher and the number of firms falls", "price and the number of firms both stay the same", "price returns to its original level and the number of firms increases", "price falls below its original level", "each firm earns positive economic profit"], "answer": 2, "explanation": "Short-run profits attract entry, which shifts market supply right until price falls back to minimum ATC. More firms now serve the larger market.", "image": ""}, {"id": "mi-4.1-01", "subject": "micro", "unit": 4, "topic": "4.1", "difficulty": "easy", "stem": "A profit-maximizing monopolist chooses its output where", "choices": ["price equals marginal cost", "marginal revenue equals marginal cost", "price equals average total cost", "total revenue is maximized", "demand is perfectly elastic"], "answer": 1, "explanation": "Like any firm, a monopolist maximizes profit where MR = MC, then charges the price the demand curve allows at that quantity.", "image": ""}, {"id": "mi-4.1-02", "subject": "micro", "unit": 4, "topic": "4.1", "difficulty": "medium", "stem": "The table shows the demand for a monopolist's product. Its marginal cost is constant at $4. What price will it charge to maximize profit?", "choices": ["$5", "$6", "$7", "$8", "$10"], "answer": 2, "explanation": "Total revenue is 10, 18, 24, 28, 30, 30, so marginal revenue is 10, 8, 6, 4, 2, 0. MR equals the $4 marginal cost at 4 units, which sell for $7.", "image": "data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%20284%20220%27%20width%3D%27284%27%20height%3D%27220%27%3E%3Crect%20width%3D%27284%27%20height%3D%27220%27%20fill%3D%27%23fff%27/%3E%3Cline%20x1%3D%2710%27%20y1%3D%2712%27%20x2%3D%27274%27%20y2%3D%2712%27%20stroke%3D%27%23000%27%20stroke-width%3D%271.4%27/%3E%3Ctext%20x%3D%2759.5%27%20y%3D%2731%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3EPrice%20%28%24%29%3C/text%3E%3Ctext%20x%3D%27191.5%27%20y%3D%2731%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3EQuantity%20demanded%3C/text%3E%3Cline%20x1%3D%2710%27%20y1%3D%2740%27%20x2%3D%27274%27%20y2%3D%2740%27%20stroke%3D%27%23000%27%20stroke-width%3D%27.9%27/%3E%3Ctext%20x%3D%2759.5%27%20y%3D%2759%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E10%3C/text%3E%3Ctext%20x%3D%27191.5%27%20y%3D%2759%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E1%3C/text%3E%3Ctext%20x%3D%2759.5%27%20y%3D%2787%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E9%3C/text%3E%3Ctext%20x%3D%27191.5%27%20y%3D%2787%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E2%3C/text%3E%3Ctext%20x%3D%2759.5%27%20y%3D%27115%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E8%3C/text%3E%3Ctext%20x%3D%27191.5%27%20y%3D%27115%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E3%3C/text%3E%3Ctext%20x%3D%2759.5%27%20y%3D%27143%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E7%3C/text%3E%3Ctext%20x%3D%27191.5%27%20y%3D%27143%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E4%3C/text%3E%3Ctext%20x%3D%2759.5%27%20y%3D%27171%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E6%3C/text%3E%3Ctext%20x%3D%27191.5%27%20y%3D%27171%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E5%3C/text%3E%3Ctext%20x%3D%2759.5%27%20y%3D%27199%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E5%3C/text%3E%3Ctext%20x%3D%27191.5%27%20y%3D%27199%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3E6%3C/text%3E%3Cline%20x1%3D%2710%27%20y1%3D%27208%27%20x2%3D%27274%27%20y2%3D%27208%27%20stroke%3D%27%23000%27%20stroke-width%3D%271.4%27/%3E%3C/svg%3E"}, {"id": "mi-4.1-03", "subject": "micro", "unit": 4, "topic": "4.1", "difficulty": "medium", "stem": "Compared with a perfectly competitive industry with the same costs, an unregulated monopoly will", "choices": ["charge a higher price and produce less", "charge a lower price and produce more", "charge the same price and produce less", "produce at minimum average total cost", "eliminate deadweight loss"], "answer": 0, "explanation": "The monopolist restricts output to where MR = MC and charges a price above marginal cost, creating deadweight loss.", "image": ""}, {"id": "mi-4.1-04", "subject": "micro", "unit": 4, "topic": "4.1", "difficulty": "medium", "stem": "A single-price monopolist's marginal revenue curve lies below its demand curve because", "choices": ["its costs rise as it produces more", "it faces a perfectly elastic demand", "the government regulates its price", "it earns zero economic profit", "it must lower the price on all units to sell one more unit"], "answer": 4, "explanation": "Selling an extra unit requires a lower price on every unit sold, so the revenue from the extra unit is less than its price.", "image": ""}, {"id": "mi-4.1-05", "subject": "micro", "unit": 4, "topic": "4.1", "difficulty": "hard", "stem": "A monopolist that practices perfect price discrimination will", "choices": ["produce less than a single-price monopolist", "charge every consumer the same price", "produce where price exceeds marginal cost for the last unit", "capture all consumer surplus and create no deadweight loss", "earn zero economic profit"], "answer": 3, "explanation": "Charging each buyer their maximum willingness to pay turns all consumer surplus into profit, and the firm sells every unit worth producing, so there is no deadweight loss.", "image": ""}, {"id": "mi-4.1-06", "subject": "micro", "unit": 4, "topic": "4.1", "difficulty": "medium", "stem": "Which of the following is a barrier to entry that can sustain a monopoly?", "choices": ["Many small sellers", "Identical products", "A government-issued patent", "Free entry and exit", "Perfect information"], "answer": 2, "explanation": "A patent legally prevents other firms from producing the good for a period of time, blocking entry.", "image": ""}, {"id": "mi-4.2-01", "subject": "micro", "unit": 4, "topic": "4.2", "difficulty": "medium", "stem": "Firm A and Firm B each choose a high or low price. The first value in each cell is Firm A's profit and the second is Firm B's. What is the Nash equilibrium?", "choices": ["Both firms choose a low price.", "Both firms choose a high price.", "Firm A chooses high and Firm B chooses low.", "Firm A chooses low and Firm B chooses high.", "There is no Nash equilibrium."], "answer": 0, "explanation": "Low is each firm's best response whatever the other does: $70 beats $50, and $30 beats $20. Both choosing low is the only outcome where neither wants to switch.", "image": "data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%20560%20170%27%20width%3D%27560%27%20height%3D%27170%27%3E%3Crect%20width%3D%27560%27%20height%3D%27170%27%20fill%3D%27%23fff%27/%3E%3Ctext%20x%3D%27390.0%27%20y%3D%2722%27%20text-anchor%3D%27middle%27%20font-size%3D%2715%27%20font-weight%3D%27bold%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3EFirm%20B%3C/text%3E%3Ctext%20x%3D%27315.0%27%20y%3D%2752%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3EHigh%20price%3C/text%3E%3Ctext%20x%3D%27465.0%27%20y%3D%2752%27%20text-anchor%3D%27middle%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3ELow%20price%3C/text%3E%3Ctext%20x%3D%2720%27%20y%3D%27107.0%27%20font-size%3D%2715%27%20font-weight%3D%27bold%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3EFirm%20A%3C/text%3E%3Ctext%20x%3D%27228%27%20y%3D%2787%27%20text-anchor%3D%27end%27%20font-size%3D%2714%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%3EHigh%20price%3C/text%3E%3Crect%20x%3D%27240%27%20y%3D%2762%27%20width%3D%27150%27%20height%3D%2740%27%20fill%3D%27none%27%20stroke%3D%27%23000%27/%3E%3Ctext%20x%3D%27315.0%27%20y%3D%2787%27%20t