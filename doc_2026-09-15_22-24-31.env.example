# Copy to .env.local for local development, and set the same two values
# in Vercel under Settings -> Environment Variables.
# Both are safe to expose in the browser: the anon key only grants what
# the row level security policies in schema.sql allow.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
